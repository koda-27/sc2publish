# Optional automation template: store outside the repository, or use CI secrets.
# Interactive use needs no .env setup: run sc2publish auth (optionally --remember).
SC2PUBLISH_EMAIL=
SC2PUBLISH_PASSWORD=
# Alternatively, point to an external email/password file:
# SC2PUBLISH_CREDENTIALS_FILE=/path/to/private/credentials.txt
# Session tokens and account details are obtained automatically.
